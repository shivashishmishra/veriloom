# VeriLoom — Configuration Template

# Database (Default development SQLite mode; change to PostgreSQL for production/pgvector)
DATABASE_URL=sqlite:///./veriloom.db
USE_PGVECTOR=false

# Security & Authentication
SECRET_KEY=veriloom-hackathon-super-secret-jwt-key-2026-inkloom-round2
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider Configuration (Optional — all deterministic checks run without an external key)
AI_PROVIDER=none # Options: none, gemini, openai, ollama
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Confidential Information Protection
MASK_CONFIDENTIAL_DATA=true

# Digital Certificate Signing (Optional Ed25519/HMAC key)
CERTIFICATE_PRIVATE_KEY=
CERTIFICATE_SIGNING_ALGORITHM=HMAC-SHA256

# Workspace & Demo Configuration
IS_DEMO_MODE=true
DEMO_BADGE_TEXT="DEMO WORKSPACE — SYNTHETIC SAMPLE DATA"
