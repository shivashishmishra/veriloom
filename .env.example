# VeriLoom — Configuration Template (.env.example)
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL

# Database (Default development SQLite mode; change to PostgreSQL for production/pgvector)
DATABASE_URL=sqlite:///./veriloom.db
USE_PGVECTOR=false

# Security & Authentication (Generate a secure 32+ character random string in production)
SECRET_KEY=change-me-to-a-secure-random-32-byte-hex-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider Configuration (Optional — all deterministic checks run without an external key)
AI_PROVIDER=none # Options: none, gemini, openai, ollama
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Confidential Information Protection
MASK_CONFIDENTIAL_DATA=true

# Digital Certificate Signing (Optional Ed25519/HMAC key)
CERTIFICATE_PRIVATE_KEY=
CERTIFICATE_SIGNING_ALGORITHM=HMAC-SHA256

# Workspace & Demo Configuration
IS_DEMO_MODE=true
DEMO_BADGE_TEXT="DEMO WORKSPACE — SYNTHETIC SAMPLE DATA"

# Frontend Configuration (When hosting frontend on GitHub Pages and backend on cloud)
# e.g., VITE_API_BASE_URL=https://veriloom-backend.onrender.com/api
VITE_API_BASE_URL=/api
